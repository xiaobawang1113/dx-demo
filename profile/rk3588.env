# RK3588: /dev/video0 is often HDMI RX; auto-detect skips it when v4l2-ctl is available.
DX_CAMERA_BACKEND="${DX_CAMERA_BACKEND:-v4l2}"
DX_CAMERA_FOURCC="${DX_CAMERA_FOURCC:-auto}"
DX_CAMERA_WIDTH="${DX_CAMERA_WIDTH:-1280}"
DX_CAMERA_HEIGHT="${DX_CAMERA_HEIGHT:-720}"
DX_CAMERA_FPS="${DX_CAMERA_FPS:-30}"
DX_CAMERA_IDX_FALLBACK="${DX_CAMERA_IDX_FALLBACK:-1}"
DX_CAMERA_SKIP_NAME_REGEX="${DX_CAMERA_SKIP_NAME_REGEX:-hdmirx|hdmi[[:space:]]*rx|rk_hdmirx}"
