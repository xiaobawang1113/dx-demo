# DEEPX NPU Environment Variables
# Firefly RK3588 + M1 (~1.92GiB): TASK_MAX_LOAD must stay 1.
# python/build.sh copies these into deepx_env.sh.

CUSTOM_INTER_OP_THREADS_COUNT=1
CUSTOM_INTRA_OP_THREADS_COUNT=1
DXRT_DYNAMIC_CPU_THREAD=1
DXRT_TASK_MAX_LOAD=1
NFH_INPUT_WORKER_THREADS=1
NFH_OUTPUT_WORKER_THREADS=1
