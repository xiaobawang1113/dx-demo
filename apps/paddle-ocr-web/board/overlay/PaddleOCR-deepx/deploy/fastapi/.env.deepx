# DEEPX NPU environment for OCR server (from upstream local_deepx_setup defaults).
# M1 NPU device memory (~1.92GiB for .dxnn) — keep TASK_MAX_LOAD=1 only.
# Board has 4GB RAM; CPU-side threads/workers can use upstream values for throughput.

CUSTOM_INTER_OP_THREADS_COUNT=1
CUSTOM_INTRA_OP_THREADS_COUNT=2
DXRT_DYNAMIC_CPU_THREAD=1
DXRT_TASK_MAX_LOAD=1
NFH_INPUT_WORKER_THREADS=2
NFH_OUTPUT_WORKER_THREADS=4
