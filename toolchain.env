# Relocatable toolchain. Source from any machine:
#   source /path/to/dx-demo/toolchain.env
_THIS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DX_DEMO_ROOT="${DX_DEMO_ROOT:-${_THIS}}"

if ! command -v gcc >/dev/null 2>&1; then
    export PATH="${HOME}/opt/gcc-11/bin:${PATH}"
fi
export CC="${CC:-$(command -v gcc)}"
export CXX="${CXX:-$(command -v g++)}"
export CMAKE_C_COMPILER="${CC}"
export CMAKE_CXX_COMPILER="${CXX}"

# Locate the installed DX-RT prefix (libdxrt + headers). Prefer a real
# install over this repo's generated .local cmake shim.
_dxrt_pick=""
if [ -n "${DXRT_INSTALLED_DIR:-}" ] && [ -e "${DXRT_INSTALLED_DIR}/lib/libdxrt.so" ]; then
    _dxrt_pick="${DXRT_INSTALLED_DIR}"
else
    for _d in \
        /usr/local \
        /usr \
        "${HOME}/deepx-2.3.0/dx-all-suite" \
        /home/t/deepx-2.3.0/dx-all-suite \
        "${HOME}/dx-all-suite" \
        /opt/deepx \
        "${DX_DEMO_ROOT}/.local"
    do
        if [ -e "${_d}/lib/libdxrt.so" ]; then
            _dxrt_pick="${_d}"
            break
        fi
    done
fi
if [ -n "${_dxrt_pick}" ]; then
    export DXRT_INSTALLED_DIR="${_dxrt_pick}"
fi

# ONNX Runtime ships with the same SDK prefix on this board.
export ONNXRUNTIME_ROOT="${ONNXRUNTIME_ROOT:-${DXRT_INSTALLED_DIR:-/usr/local}}"

# CMake find_package(dxrt) needs a Config file. SDK 2.3.0's /usr/local install
# often has libdxrt.so but no dxrtConfig.cmake. Write a shim under .local/
# (gitignored) so every app CMakeLists works after `source toolchain.env`.
_dxrt_lib=""
_dxrt_inc=""
if [ -n "${DXRT_INSTALLED_DIR:-}" ] && [ -e "${DXRT_INSTALLED_DIR}/lib/libdxrt.so" ]; then
    _dxrt_lib="${DXRT_INSTALLED_DIR}/lib/libdxrt.so"
fi
if [ -n "${DXRT_INSTALLED_DIR:-}" ] && [ -d "${DXRT_INSTALLED_DIR}/include/dxrt" ]; then
    _dxrt_inc="${DXRT_INSTALLED_DIR}/include"
elif [ -d /usr/local/include/dxrt ]; then
    _dxrt_inc="/usr/local/include"
    [ -z "${_dxrt_lib}" ] && [ -e /usr/local/lib/libdxrt.so ] && _dxrt_lib="/usr/local/lib/libdxrt.so"
fi
if [ -n "${_dxrt_lib}" ] && [ -n "${_dxrt_inc}" ]; then
    _shim="${DX_DEMO_ROOT}/.local/lib/cmake/dxrt"
    mkdir -p "${_shim}"
    cat > "${_shim}/dxrtConfig.cmake" <<EOF
# Generated by toolchain.env — do not edit. Points at the machine's libdxrt.
if(NOT TARGET dxrt)
  add_library(dxrt SHARED IMPORTED)
  set_target_properties(dxrt PROPERTIES
    IMPORTED_LOCATION "${_dxrt_lib}"
    INTERFACE_INCLUDE_DIRECTORIES "${_dxrt_inc}"
  )
endif()
set(dxrt_FOUND TRUE)
set(DXRT_FOUND TRUE)
set(DXRT_LIBRARIES dxrt)
set(DXRT_INCLUDE_DIRS "${_dxrt_inc}")
set(DXRT_INCLUDE_DIR "${_dxrt_inc}")
EOF
    export CMAKE_PREFIX_PATH="${DX_DEMO_ROOT}/.local${CMAKE_PREFIX_PATH:+:${CMAKE_PREFIX_PATH}}"
fi
if [ -n "${DXRT_INSTALLED_DIR:-}" ]; then
    export CMAKE_PREFIX_PATH="${CMAKE_PREFIX_PATH:+${CMAKE_PREFIX_PATH}:}${DXRT_INSTALLED_DIR}"
fi

# Firefly: /dev/video0 is HDMI RX, USB webcam is usually video1.
export DX_CAMERA_IDX="${DX_CAMERA_IDX:-1}"
export DX_CAMERA_DEV="/dev/video${DX_CAMERA_IDX}"
export DISPLAY="${DISPLAY:-:0}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK="${PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK:-True}"
export DXRT_TASK_MAX_LOAD="${DXRT_TASK_MAX_LOAD:-1}"
unset _THIS _d _dxrt_pick _dxrt_lib _dxrt_inc _shim
