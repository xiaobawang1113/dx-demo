# Local toolchain for Firefly RK3588.
# System gcc/g++ are installed; keep extracted gcc-11 as fallback.
if ! command -v gcc >/dev/null 2>&1; then
    export PATH="/home/teamhd/opt/gcc-11/bin:${PATH}"
fi
export CC="${CC:-$(command -v gcc)}"
export CXX="${CXX:-$(command -v g++)}"
export CMAKE_C_COMPILER="${CC}"
export CMAKE_CXX_COMPILER="${CXX}"
# find_package(dxrt) + unversioned libonnxruntime.so
export CMAKE_PREFIX_PATH="/home/teamhd/dx-demo/.local${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
export DXRT_INSTALLED_DIR="/home/teamhd/dx-demo/.local"
export ONNXRUNTIME_ROOT="/home/teamhd/dx-demo/.local"
# USB webcam is /dev/video1 (video0 is HDMI RX on this board)
export DX_CAMERA_IDX="${DX_CAMERA_IDX:-1}"
export DX_CAMERA_DEV="/dev/video${DX_CAMERA_IDX}"
export DISPLAY="${DISPLAY:-:0}"
